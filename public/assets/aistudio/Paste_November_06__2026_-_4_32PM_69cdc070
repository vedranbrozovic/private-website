<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ACAP Official Email Signature Generator</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #1e293b;
    }
    ::-webkit-scrollbar-thumb {
      background: #475569;
      border-radius: 3px;
    }
    .viewport-transition {
      transition: max-width 0.35s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.25s ease, color 0.25s ease;
    }
    .step-badge {
      background: linear-gradient(135deg, #e81053 0%, #be0b42 100%);
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Official ACAP Member Portal Header -->
  <header class="bg-[#010333] text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        
        <!-- Brand Identity -->
        <div class="flex items-center gap-3.5">
          <div class="px-2.5 py-1.5 rounded-lg bg-white flex items-center justify-center shadow-sm shrink-0">
            <span class="text-[#e81053] font-black tracking-tighter text-lg leading-none">ACAP</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base sm:text-lg font-bold text-white leading-tight">Official Email Signature Generator</h1>
              <span class="hidden md:inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-[#e81053] text-white">Member Tool</span>
            </div>
            <p class="text-xs text-slate-300">Association of Croatian American Professionals • Create & install in 60 seconds</p>
          </div>
        </div>

        <!-- Primary One-Click Copy CTA -->
        <div class="flex items-center gap-2.5">
          <button id="btnHeaderCopy" onclick="copyVisualSignature()" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#e81053] hover:bg-[#ff1f64] active:scale-[0.99] text-white font-semibold text-sm px-5 py-2.5 rounded-lg shadow-md transition-all cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
            </svg>
            <span>Copy Signature</span>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Quick 3-Step Progress Bar Banner -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 text-xs">
        <div class="flex items-center gap-2.5 py-1">
          <span class="w-6 h-6 rounded-full step-badge text-white font-bold flex items-center justify-center shrink-0 shadow-xs">1</span>
          <div>
            <span class="font-bold text-slate-900">Enter Your Details</span>
            <span class="text-slate-500 block sm:inline sm:ml-1">— Name, ACAP title & optional contact</span>
          </div>
        </div>
        <div class="flex items-center gap-2.5 py-1">
          <span class="w-6 h-6 rounded-full step-badge text-white font-bold flex items-center justify-center shrink-0 shadow-xs">2</span>
          <div>
            <span class="font-bold text-slate-900">Click "Copy Signature"</span>
            <span class="text-slate-500 block sm:inline sm:ml-1">— Copies rich formatting, icons & buttons</span>
          </div>
        </div>
        <div class="flex items-center gap-2.5 py-1">
          <span class="w-6 h-6 rounded-full step-badge text-white font-bold flex items-center justify-center shrink-0 shadow-xs">3</span>
          <div>
            <span class="font-bold text-slate-900">Paste in Email Settings</span>
            <span class="text-slate-500 block sm:inline sm:ml-1">— Follow the 1-minute guide below</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Banner -->
  <div id="toastBanner" class="fixed bottom-5 right-5 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="bg-slate-900 text-white px-5 py-4 rounded-xl shadow-2xl border border-emerald-500/40 flex items-center gap-3.5 max-w-md">
      <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <div>
        <p id="toastTitle" class="text-sm font-bold text-white">Signature Copied to Clipboard!</p>
        <p id="toastSub" class="text-xs text-slate-300 mt-0.5">Now open your Gmail, Outlook, or Apple Mail signature settings and press Cmd+V (Mac) or Ctrl+V (Windows).</p>
      </div>
    </div>
  </div>

  <!-- Main Workspace -->
  <main class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- LEFT COLUMN: Step 1 - Personalize Your Signature (5 cols) -->
    <section class="lg:col-span-5 space-y-5">
      
      <!-- Step 1 Card: Member Details -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full step-badge text-white text-xs font-bold flex items-center justify-center">1</span>
            <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wide">Personalize Your Info</h2>
          </div>
          <button onclick="resetForm()" class="text-xs text-slate-400 hover:text-[#e81053] font-medium transition-colors cursor-pointer">
            Reset Default
          </button>
        </div>

        <!-- Full Name -->
        <div>
          <label for="inputName" class="block text-xs font-semibold text-slate-700 mb-1">Full Name <span class="text-[#e81053]">*</span></label>
          <input id="inputName" type="text" value="Vedran Brozović" placeholder="e.g., Ana Horvat" oninput="updateSignature()" class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#e81053] focus:border-transparent font-medium text-slate-900">
        </div>

        <!-- Role / Title Input + Quick Role Chips -->
        <div>
          <label for="inputRole" class="block text-xs font-semibold text-slate-700 mb-1">Your ACAP Title / Role <span class="text-[#e81053]">*</span></label>
          <input id="inputRole" type="text" value="Board member | Seattle Conference Chair" placeholder="e.g., Member | Seattle Chapter" oninput="updateSignature()" class="w-full px-3.5 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-[#e81053] focus:border-transparent font-medium text-slate-900">
          
          <div class="mt-2">
            <span class="block text-[11px] font-medium text-slate-400 mb-1.5">Quick-fill common templates (click to apply):</span>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" onclick="setRolePreset('Board member | Seattle Conference Chair')" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 hover:bg-rose-50 hover:text-[#e81053] text-slate-700 font-medium border border-slate-200 transition-colors cursor-pointer">
                Seattle Conference Chair
              </button>
              <button type="button" onclick="setRolePreset('Board member | Technology and Innovation')" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 hover:bg-rose-50 hover:text-[#e81053] text-slate-700 font-medium border border-slate-200 transition-colors cursor-pointer">
                Tech & Innovation Chair
              </button>
              <button type="button" onclick="setRolePreset('Board Member')" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 hover:bg-rose-50 hover:text-[#e81053] text-slate-700 font-medium border border-slate-200 transition-colors cursor-pointer">
                Board Member
              </button>
              <button type="button" onclick="setRolePreset('Chapter President | ACAP Seattle')" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 hover:bg-rose-50 hover:text-[#e81053] text-slate-700 font-medium border border-slate-200 transition-colors cursor-pointer">
                Chapter President
              </button>
              <button type="button" onclick="setRolePreset('Committee Member')" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 hover:bg-rose-50 hover:text-[#e81053] text-slate-700 font-medium border border-slate-200 transition-colors cursor-pointer">
                Committee Member
              </button>
              <button type="button" onclick="setRolePreset('Member')" class="text-[11px] px-2.5 py-1 rounded-md bg-slate-100 hover:bg-rose-50 hover:text-[#e81053] text-slate-700 font-medium border border-slate-200 transition-colors cursor-pointer">
                General Member
              </button>
            </div>
          </div>
        </div>

        <!-- Optional Phone / Email Contact Line -->
        <div class="pt-2 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="inputPhone" class="block text-xs font-medium text-slate-600 mb-1">Phone <span class="text-slate-400 font-normal">(Optional)</span></label>
            <input id="inputPhone" type="text" value="" placeholder="e.g., +1 (206) 555-0199" oninput="updateSignature()" class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#e81053]">
          </div>
          <div>
            <label for="inputChapter" class="block text-xs font-medium text-slate-600 mb-1">Org Subtitle Line</label>
            <input id="inputChapter" type="text" value="ACAP Foundation" placeholder="e.g., ACAP Foundation" oninput="updateSignature()" class="w-full px-3 py-1.5 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#e81053]">
          </div>
        </div>
      </div>

      <!-- Dark Mode & Appearance Settings Card -->
      <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-xs space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Dark Mode & Icon Appearance</h2>
          <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">100% Email-Safe</span>
        </div>

        <!-- Dark Mode Color Strategy Selector -->
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">
            Text Color Mode (Light & Dark Mode Visibility)
          </label>
          <div class="grid grid-cols-1 gap-2">
            <button type="button" id="btnPaletteAdaptive" onclick="setColorPalette('adaptive')" class="text-left p-3 rounded-lg border-2 border-[#e81053] bg-rose-50/40 transition-all cursor-pointer">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-900">Universal Adaptive (Recommended)</span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-[#e81053] text-white">Best for Dark Mode</span>
              </div>
              <p class="text-[11px] text-slate-600 mt-1 leading-relaxed">
                Uses client-adaptive text for your Name & Role (automatically turns crisp white in Dark Mode and dark navy/black in Light Mode) + solid pill button so nothing ever disappears.
              </p>
            </button>

            <button type="button" id="btnPaletteCrimson" onclick="setColorPalette('crimson')" class="text-left p-3 rounded-lg border border-slate-200 hover:border-slate-300 bg-white transition-all cursor-pointer">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-800">ACAP Crimson Accent Name (<code class="text-[#e81053]">#e81053</code>)</span>
                <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-600">High Contrast</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
                Highlights your name in vibrant ACAP Crimson with adaptive role text — stands out strongly on both white and dark backgrounds.
              </p>
            </button>

            <button type="button" id="btnPaletteClassic" onclick="setColorPalette('classic')" class="text-left p-3 rounded-lg border border-slate-200 hover:border-slate-300 bg-white transition-all cursor-pointer">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-800">Classic Hardcoded Navy (<code class="text-slate-600">#010333</code>)</span>
                <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">Light Mode Best</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
                Locks `#010333` navy on Name & Role. Looks classic on white backgrounds, though older dark-mode clients without auto-inversion may render `#010333` dim.
              </p>
            </button>
          </div>
        </div>

        <!-- Social Media Icon Style Toggle -->
        <div class="pt-2 border-t border-slate-100">
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Social Media Icon Style (LinkedIn, Instagram, Facebook, YouTube)</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="btnIconsBrand" onclick="setIconStyle('brand')" class="py-2 px-3 rounded-lg border-2 border-[#e81053] bg-rose-50/40 text-[#e81053] text-xs font-bold transition-all cursor-pointer">
              Official Brand Colors
            </button>
            <button type="button" id="btnIconsMinimal" onclick="setIconStyle('minimal')" class="py-2 px-3 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 text-xs font-medium transition-all cursor-pointer">
              Minimal Dark/Light Safe
            </button>
          </div>
        </div>

        <!-- Button Order Option -->
        <div class="pt-2 border-t border-slate-100">
          <label class="block text-xs font-semibold text-slate-700 mb-1.5">Action Button Order</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="btnOrderMemberFirst" onclick="setButtonOrder('member-first')" class="text-xs py-2 px-2.5 rounded-lg border-2 border-[#e81053] bg-rose-50/40 text-[#e81053] font-bold transition-all cursor-pointer">
              "Become a Member" First
            </button>
            <button type="button" id="btnOrderWebsiteFirst" onclick="setButtonOrder('website-first')" class="text-xs py-2 px-2.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 font-medium transition-all cursor-pointer">
              "Visit Our Website" First
            </button>
          </div>
        </div>

      </div>

    </section>

    <!-- RIGHT COLUMN: Step 2 (Live Preview & Copy) + Step 3 (Setup Instructions) (7 cols) -->
    <section class="lg:col-span-7 flex flex-col gap-6">
      
      <!-- STEP 2 CARD: Live Preview & One-Click Copy -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden flex flex-col">
        
        <!-- Preview Header Bar with Device & Theme Toggles -->
        <div class="bg-slate-100 border-b border-slate-200 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="w-6 h-6 rounded-full step-badge text-white text-xs font-bold flex items-center justify-center">2</span>
            <div>
              <h2 class="text-sm font-bold text-slate-900 leading-none">Live Signature Preview</h2>
              <span id="viewportBadge" class="text-[11px] text-slate-500">Desktop View • Light Email Client</span>
            </div>
          </div>

          <!-- Interactive Simulator Toggles -->
          <div class="flex flex-wrap items-center gap-2">
            <!-- Viewport Switcher -->
            <div class="inline-flex bg-slate-200/80 p-0.5 rounded-lg">
              <button type="button" id="btnDesktop" onclick="setViewport('desktop')" class="px-2.5 py-1 rounded-md text-xs font-semibold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer">
                💻 Desktop
              </button>
              <button type="button" id="btnMobile" onclick="setViewport('mobile')" class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
                📱 Mobile
              </button>
            </div>

            <!-- Light / Dark Theme Switcher -->
            <div class="inline-flex bg-slate-200/80 p-0.5 rounded-lg">
              <button type="button" id="btnLight" onclick="setTheme('light')" class="px-2.5 py-1 rounded-md text-xs font-semibold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer">
                ☀️ Light
              </button>
              <button type="button" id="btnDark" onclick="setTheme('dark')" class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
                🌙 Dark Mode
              </button>
            </div>
          </div>
        </div>

        <!-- Outer Canvas Area -->
        <div class="p-4 sm:p-6 bg-slate-200/60 flex flex-col items-center justify-center">
          
          <!-- Simulated Email Client Window -->
          <div id="emailClientContainer" class="viewport-transition w-full max-w-full bg-white text-slate-900 rounded-xl shadow-md border border-slate-200/90 overflow-hidden">
            
            <!-- Simulated Email Header -->
            <div id="emailHeader" class="px-5 py-2.5 border-b border-slate-100 text-xs flex flex-wrap items-center justify-between gap-2 text-slate-500">
              <div class="flex items-center gap-2">
                <span class="font-medium text-slate-400">To:</span>
                <span id="emailRecipientPill" class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-medium">community@croampro.com</span>
              </div>
              <span id="darkModeStatusNote" class="text-[11px] text-emerald-600 font-medium hidden">
                ✓ Dark Mode Active: All text & buttons remain high-contrast
              </span>
            </div>

            <!-- Simulated Email Body + Live Signature Mount -->
            <div id="emailBodyArea" class="p-5 sm:p-6">
              <p id="emailGreetingText" class="text-xs sm:text-sm text-slate-600 mb-5 font-sans leading-relaxed">
                Hi everyone,<br>
                Looking forward to connecting at our upcoming ACAP events and growing our global network.<br><br>
                Best regards,
              </p>

              <!-- ======================================================= -->
              <!-- ACTUAL EMAIL SIGNATURE CONTAINER (COPIED TO CLIPBOARD)  -->
              <!-- ======================================================= -->
              <div id="signatureMountPoint"></div>
              <!-- ======================================================= -->

            </div>

          </div>

          <!-- Big Prominent Copy Action Bar Under Preview -->
          <div class="w-full mt-4 bg-white rounded-xl p-4 border border-slate-200/90 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="text-center sm:text-left">
              <p class="text-xs font-bold text-slate-900">Ready to use your new signature?</p>
              <p class="text-[11px] text-slate-500">Click the button to copy the visual signature with all images, links & buttons.</p>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <button id="btnMainCopy" onclick="copyVisualSignature()" class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 bg-[#e81053] hover:bg-[#c90d47] active:scale-[0.99] text-white font-bold text-sm px-6 py-3 rounded-lg shadow-sm transition-all cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                </svg>
                <span id="btnMainCopyText">Copy Signature to Clipboard</span>
              </button>
              <button onclick="copyRawHtml()" title="Copy Raw HTML Source Code" class="inline-flex items-center justify-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3.5 py-3 rounded-lg border border-slate-200 transition-all cursor-pointer">
                <span>&lt;/&gt; HTML</span>
              </button>
            </div>
          </div>

        </div>
      </div>

      <!-- STEP 3 CARD: Easy 1-Minute Setup Guide for Members (Tabbed) -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-slate-50/60">
          <div class="flex items-center gap-2.5">
            <span class="w-6 h-6 rounded-full step-badge text-white text-xs font-bold flex items-center justify-center">3</span>
            <div>
              <h3 class="text-sm font-bold text-slate-900">How to Paste Into Your Email Client</h3>
              <p class="text-xs text-slate-500">Select your email app below and follow the 4 quick steps</p>
            </div>
          </div>

          <!-- Client Instruction Tabs -->
          <div class="inline-flex bg-slate-200/80 p-1 rounded-lg self-start sm:self-auto">
            <button type="button" id="tabBtnGmail" onclick="switchGuideTab('gmail')" class="px-3 py-1.5 rounded-md text-xs font-bold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer">
              Gmail
            </button>
            <button type="button" id="tabBtnOutlook" onclick="switchGuideTab('outlook')" class="px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
              Outlook
            </button>
            <button type="button" id="tabBtnApple" onclick="switchGuideTab('apple')" class="px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer">
              Apple Mail
            </button>
          </div>
        </div>

        <!-- Tab Content: Gmail -->
        <div id="guideContentGmail" class="p-5 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200/80 flex gap-3">
              <span class="w-6 h-6 rounded-full bg-rose-100 text-[#e81053] font-bold flex items-center justify-center shrink-0">1</span>
              <div>
                <p class="font-bold text-slate-900">Copy Your Signature</p>
                <p class="text-slate-600 mt-0.5">Click the pink <strong>"Copy Signature to Clipboard"</strong> button above.</p>
              </div>
            </div>
            <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200/80 flex gap-3">
              <span class="w-6 h-6 rounded-full bg-rose-100 text-[#e81053] font-bold flex items-center justify-center shrink-0">2</span>
              <div>
                <p class="font-bold text-slate-900">Open Gmail Settings</p>
                <p class="text-slate-600 mt-0.5">In Gmail on your computer, click the <strong>⚙️ Gear icon</strong> (top right) → <strong>"See all settings"</strong>.</p>
              </div>
            </div>
            <div class="p-3.5 rounded-lg bg-slate-50 border border-slate-200/80 flex gap-3">
              <span class="w-6 h-6 rounded-full bg-rose-100 text-[#e81053] font-bold flex items-center justify-center shrink-0">3</span>
              <div>
                <p class="font-bold text-slate-900">Paste Into Signature Box</p>
