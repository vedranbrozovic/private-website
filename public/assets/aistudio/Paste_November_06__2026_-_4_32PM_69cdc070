        container.style.maxWidth = '100%';
        btnDesktop.className = "px-2.5 py-1 rounded-md text-xs font-semibold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer";
        btnMobile.className = "px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer";
      }
      updateViewportBadge();
    }

    // Light / Dark email client simulation toggle
    function setTheme(theme) {
      currentState.theme = theme;
      const container = document.getElementById('emailClientContainer');
      const header = document.getElementById('emailHeader');
      const recipientPill = document.getElementById('emailRecipientPill');
      const greeting = document.getElementById('emailGreetingText');
      const darkNote = document.getElementById('darkModeStatusNote');
      const btnLight = document.getElementById('btnLight');
      const btnDark = document.getElementById('btnDark');

      if (theme === 'dark') {
        // Set dark background AND light default text color (#f8fafc) just like Gmail/Outlook/Apple Mail Dark Mode
        container.classList.remove('bg-white', 'text-slate-900', 'border-slate-200/90');
        container.classList.add('bg-[#14171f]', 'text-slate-100', 'border-slate-700');
        header.classList.remove('border-slate-100');
        header.classList.add('border-slate-800');
        recipientPill.classList.remove('bg-slate-100', 'text-slate-700');
        recipientPill.classList.add('bg-slate-800', 'text-slate-200');
        greeting.classList.remove('text-slate-600');
        greeting.classList.add('text-slate-300');
        darkNote.classList.remove('hidden');

        btnDark.className = "px-2.5 py-1 rounded-md text-xs font-semibold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer";
        btnLight.className = "px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer";
      } else {
        container.classList.add('bg-white', 'text-slate-900', 'border-slate-200/90');
        container.classList.remove('bg-[#14171f]', 'text-slate-100', 'border-slate-700');
        header.classList.add('border-slate-100');
        header.classList.remove('border-slate-800');
        recipientPill.classList.add('bg-slate-100', 'text-slate-700');
        recipientPill.classList.remove('bg-slate-800', 'text-slate-200');
        greeting.classList.add('text-slate-600');
        greeting.classList.remove('text-slate-300');
        darkNote.classList.add('hidden');

        btnLight.className = "px-2.5 py-1 rounded-md text-xs font-semibold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer";
        btnDark.className = "px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer";
      }
      updateViewportBadge();
    }

    // Switch Step 3 Setup Instruction Tabs (Gmail / Outlook / Apple Mail)
    function switchGuideTab(client) {
      const tabs = ['gmail', 'outlook', 'apple'];
      const btnMap = {
        gmail: document.getElementById('tabBtnGmail'),
        outlook: document.getElementById('tabBtnOutlook'),
        apple: document.getElementById('tabBtnApple')
      };
      const contentMap = {
        gmail: document.getElementById('guideContentGmail'),
        outlook: document.getElementById('guideContentOutlook'),
        apple: document.getElementById('guideContentApple')
      };

      tabs.forEach(t => {
        if (t === client) {
          btnMap[t].className = "px-3 py-1.5 rounded-md text-xs font-bold bg-white text-slate-900 shadow-2xs transition-all cursor-pointer";
          contentMap[t].classList.remove('hidden');
        } else {
          btnMap[t].className = "px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all cursor-pointer";
          contentMap[t].classList.add('hidden');
        }
      });
    }

    // Toast notification helper
    let toastTimer = null;
    function showToast(title, subtitle) {
      const toast = document.getElementById('toastBanner');
      document.getElementById('toastTitle').textContent = title;
      document.getElementById('toastSub').textContent = subtitle;

      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('translate-y-24', 'opacity-0');
        toast.classList.remove('translate-y-0', 'opacity-100');
      }, 4200);
    }

    // Copy rendered visual signature for pasting directly into Gmail / Outlook / Apple Mail
    function copyVisualSignature() {
      const cleanHtml = buildCleanExportHTML();

      const tempContainer = document.createElement('div');
      tempContainer.style.position = 'fixed';
      tempContainer.style.left = '-9999px';
      tempContainer.style.top = '0';
      tempContainer.style.backgroundColor = '#ffffff';
      tempContainer.style.color = '#010333';
      tempContainer.innerHTML = cleanHtml;
      document.body.appendChild(tempContainer);

      try {
        const range = document.createRange();
        range.selectNodeContents(tempContainer);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);

        document.execCommand('copy');
        selection.removeAllRanges();

        // Visual feedback on copy button
        const btnText = document.getElementById('btnMainCopyText');
        if (btnText) {
          const orig = btnText.textContent;
          btnText.textContent = '✓ Copied! Ready to Paste (Cmd+V / Ctrl+V)';
          setTimeout(() => { btnText.textContent = orig; }, 3000);
        }

        showToast(
          'Signature Copied to Clipboard!',
          'Follow Step 3 below: Open your email settings and press Cmd+V (Mac) or Ctrl+V (Windows).'
        );
      } catch (err) {
        const mount = document.getElementById('signatureMountPoint');
        const range = document.createRange();
        range.selectNodeContents(mount);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        document.execCommand('copy');
        selection.removeAllRanges();
        showToast(
          'Signature Copied!',
          'Paste directly into your Gmail, Outlook, or Apple Mail signature box.'
        );
      } finally {
        document.body.removeChild(tempContainer);
      }
    }

    // Copy Raw HTML source code
    function copyRawHtml() {
      const rawHtml = buildCleanExportHTML();
      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = rawHtml;
      tempTextArea.style.position = 'fixed';
      tempTextArea.style.left = '-9999px';
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      document.execCommand('copy');
      document.body.removeChild(tempTextArea);

      showToast(
        'Raw HTML Source Copied!',
        'Ready to paste into any HTML-based email signature manager.'
      );
    }

    // Initialize on window load
    window.onload = function () {
      updateSignature();
    };
  </script>
